  ctx.fillStyle = "rgba(6,12,22,.9)"; ctx.fillRect(x0-6,y-6,x1-x0+12,h+12);
  ctx.fillStyle = g; ctx.fillRect(x0,y,x1-x0,h);
  ctx.strokeStyle = "#fff"; ctx.lineWidth = 2; ctx.strokeRect(lerp(x0,x1,.42),y-3,(x1-x0)*.16,h+6);
  ctx.fillStyle = "#fff"; ctx.fillRect(lerp(x0,x1,S.meter.m)-3,y-8,6,h+16);
  txt(PITCHES[S.sel].name + ": tap when the marker hits the gold", CX, 622, 22, "#ffffff", BODY);
  txt("Better timing means a tighter spot", CX, 700, 18, "rgba(255,255,255,.7)", BODY, "center", false);
}
function drawButtons(){
  BTN.forEach(b => {
    const on = b.i === S.sel, T = PITCHES[b.i];
    ctx.fillStyle = on ? "#f2c230" : "rgba(8,16,30,.88)"; ctx.fillRect(b.x,b.y,b.w,b.h);
    ctx.strokeStyle = on ? "#fff" : "rgba(255,255,255,.25)"; ctx.lineWidth = on ? 3 : 1.5; ctx.strokeRect(b.x,b.y,b.w,b.h);
    txt(T.name, b.x+b.w/2, b.y+26, 23, on ? "#0b1428" : "#fff", BODY, "center", false);
    txt(T.desc, b.x+b.w/2, b.y+50, 17, on ? "#33291a" : "#a9b8d3", BODY, "center", false);
  });
}

/* ---------- HUD, banner, overlays ---------- */
function drawHUD(){
  const v = V, bs = v.half === "top" ? 0 : 1;
  ctx.fillStyle = "rgba(6,12,22,.84)"; ctx.fillRect(0,0,W,76);
  ctx.fillStyle = "#f2c230"; ctx.fillRect(0,76,W,2);
  txt((v.half === "top" ? "Top " : "Bottom ") + v.inning + "  " + S.names[bs] + " at bat", 14, 22, 20, "#cfd8ea", BODY, "left", false);
  txt(S.names[0] + " " + v.score[0] + "   " + S.names[1] + " " + v.score[1], 14, 52, 24, "#ffd95a", DISPLAY, "left", false);
  txt("B " + v.balls + "   S " + v.strikes, 300, 22, 22, "#fff", BODY, "center", false);
  for (let i=0;i<3;i++){
    ctx.beginPath(); ctx.arc(268+i*18, 52, 6.5, 0, 7);
    ctx.fillStyle = i < v.outs ? "#ffd95a" : "rgba(255,255,255,.18)"; ctx.fill();
  }
  txt("Outs", 328, 52, 18, "#9fb0cc", BODY, "left", false);
  const bx = 432, by = 38, pos = [[bx+22,by],[bx,by-20],[bx-22,by]];
  for (let i=0;i<3;i++){
    ctx.save(); ctx.translate(pos[i][0], pos[i][1]+10); ctx.rotate(Math.PI/4);
    ctx.fillStyle = v.bases[i] ? "#ffd95a" : "rgba(255,255,255,.16)"; ctx.fillRect(-8,-8,16,16); ctx.restore();
  }
}
function drawBanner(){
  const b = S.banner; if (!b) return;
  const e = Math.min(1, b.t/.18), s = .8 + .2*(1-Math.pow(1-e,3));
  ctx.save(); ctx.translate(CX, S.view === "bat" ? 350 : 540); ctx.scale(s,s); ctx.globalAlpha = Math.min(1,b.t/.1);
  txt(b.text, 0, 0, b.text.length > 16 ? 34 : 48, b.color, DISPLAY);
  if (b.sub) txt(b.sub, 0, 42, 26, "#fff", BODY);
  ctx.restore();
}
function dim(a=.82){ ctx.fillStyle = "rgba(5,10,20," + a + ")"; ctx.fillRect(0,0,W,H); }
function btn(b, primary=true){
  ctx.fillStyle = primary ? "#f2c230" : "rgba(255,255,255,.12)"; ctx.fillRect(b.x,b.y,b.w,b.h);
  if (!primary){ ctx.strokeStyle = "rgba(255,255,255,.35)"; ctx.lineWidth = 1.5; ctx.strokeRect(b.x,b.y,b.w,b.h); }
  txt(b.label, b.x+b.w/2, b.y+b.h/2+1, 30, primary ? "#0b1428" : "#d6e0f2", BODY, "center", false);
}
const inRect = (pt,b) => pt.x >= b.x && pt.x <= b.x+b.w && pt.y >= b.y && pt.y <= b.y+b.h;

function overBtns(){
  return S.mode === "online"
    ? [{x:90,y:540,w:300,h:56,label:"Main menu",act:"menu"}]
    : [{x:90,y:520,w:300,h:56,label:"Play again",act:"again"},{x:90,y:590,w:300,h:56,label:"Main menu",act:"menu"}];
}

function drawOverlays(){
  const st = S.phase;
  if (st === "menu" || st === "lobby"){
    dim(.8);
    txt("Night Game", CX, 190, 54, "#ffd95a", DISPLAY);
    txt("Showdown", CX, 248, 54, "#fff", DISPLAY);
    if (st === "menu"){
      txt("Bat and pitch. Every half inning you switch roles.", CX, 296, 22, "#b8c5de", BODY, "center", false);
      MENU_BTN.forEach(b => btn(b));
      txt("Three innings. Most runs wins.", CX, 590, 22, "#b8c5de", BODY, "center", false);
    }
  }
  if (st === "handoff"){
    dim(.94);
    const h = S.handoff;
    txt("Pass to " + S.full[h.side], CX, 290, 46, "#ffd95a", DISPLAY);
    txt("You " + (h.role === "pitcher" ? "pitch" : "bat") + " this one", CX, 350, 30, "#fff", BODY, "center", false);
    ctx.globalAlpha = .75 + .25*Math.sin(performance.now()/260);
    ctx.fillStyle = "#f2c230"; ctx.fillRect(CX-130, 420, 260, 56); ctx.globalAlpha = 1;
    txt("Tap when ready", CX, 449, 30, "#0b1428", BODY, "center", false);
  }
  if (st === "over"){
    dim(.84);
    let t1, t2;
    if (G.winner === -1){ t1 = "Tie"; t2 = "game"; }
    else if (S.mode === "pass"){ t1 = S.full[G.winner]; t2 = "wins!"; }
    else if (S.ctrl[G.winner] === "human"){ t1 = "You"; t2 = "win!"; }
    else { t1 = S.mode === "cpu" ? "CPU" : "Opponent"; t2 = "wins"; }
    txt(t1, CX, 205, 52, "#ffd95a", DISPLAY); txt(t2, CX, 262, 52, "#fff", DISPLAY);
    txt("Final: " + S.full[0] + " " + G.score[0] + ", " + S.full[1] + " " + G.score[1], CX, 340, 28, "#fff", BODY, "center", false);
    txt(G.inning > INN ? "Went to extra innings." : "", CX, 376, 22, "#b8c5de", BODY, "center", false);
    overBtns().forEach((b,i) => btn(b, i === 0));
  }
  if (S.msgT > 0 && S.msg){
    ctx.fillStyle = "rgba(6,12,22,.92)"; ctx.fillRect(30,92,420,40);
    txt(S.msg, CX, 112, 20, "#ffd95a", BODY, "center", false);
  }
}

function draw(){
  if (S.view === "bat") drawBatView(); else drawPitchView();
  for (const q of S.particles){ ctx.fillStyle = q.c; ctx.globalAlpha = clamp(q.life,0,1); ctx.fillRect(q.x,q.y,q.s,q.s); }
  ctx.globalAlpha = 1;
  const st = S.phase;
  if (st !== "menu" && st !== "lobby") drawHUD();
  if (S.info && (st === "flight" || st === "hit" || st === "result")) txt(S.info, CX, 100, 24, "#fff", BODY);
  drawBanner();
  if (st === "aim"){
    drawButtons();
    txt("Pick a pitch, then tap where you want it", CX, 612, 20, "rgba(255,255,255,.85)", BODY);
  }
  if (st === "meter") drawMeter();
  if (st === "wait") txt("Waiting for the pitch...", CX, 600, 26, "#fff", BODY);
  if (st === "flight" && S.view === "bat") txt("Tap the ball when it reaches the zone", CX, 706, 20, "rgba(255,255,255,.7)", BODY, "center", false);
  if (st === "flight" && S.view === "pitch" && S.ctrl[batSide()] === "remote" && S.pitch.t > S.pitch.dur && !S.pending)
    txt("Waiting for the batter...", CX, 600, 24, "#fff", BODY);
  drawOverlays();
}

/* ---------- input ---------- */
function toCanvas(e){
  const r = cv.getBoundingClientRect();
  return {x:(e.clientX-r.left)*W/r.width, y:(e.clientY-r.top)*H/r.height};
}
function choose(act){
  if (act === "cpu" || act === "pass") startGame(act, 0);
  else if (act === "online"){ S.phase = "lobby"; lobby.hidden = false; setStat("Create a game and send the code to a friend, or enter the code they sent you."); }
  else if (act === "again") startGame(S.mode, S.me);
  else if (act === "menu"){ leaveRoom(); S.phase = "menu"; S.view = "pitch"; V = snapG(); S.pitch = null; S.flight = null; S.bat = null; S.banner = null; }
}
function press(pt){
  switch (S.phase){
    case "menu": for (const b of MENU_BTN) if (inRect(pt,b)) choose(b.act); break;
    case "over": if (performance.now() - S.overAt > 500) for (const b of overBtns()) if (inRect(pt,b)) choose(b.act); break;
    case "handoff": { const h = S.handoff; S.lastActor = h.side; S.phase = h.phase; S.handoff = null; break; }
    case "aim":
      if (pt.y >= 626){
        for (const b of BTN) if (inRect(pt,b)){ S.sel = b.i; tone(500,.05,"triangle",.04); }
      } else if (pt.y > 90){ S.aim = clampAim(pt.x, pt.y); S.meter = {m:0,dir:1}; S.phase = "meter"; }
      break;
    case "meter": release(); break;
    case "flight": swing(pt.x, pt.y); break;
  }
}
cv.addEventListener("pointermove", e => { S.pointer = toCanvas(e); });
cv.addEventListener("pointerdown", e => { e.preventDefault(); S.pointer = toCanvas(e); press(S.pointer); });
window.addEventListener("keydown", e => {
  if (S.phase === "aim" && e.code >= "Digit1" && e.code <= "Digit4"){ S.sel = +e.code.slice(5) - 1; return; }
  if (e.code === "Space" || e.code === "Enter"){
    if (document.activeElement && document.activeElement.tagName === "INPUT") return;
    e.preventDefault();
    if (S.phase === "aim") press({x:S.pointer.x, y:Math.min(S.pointer.y,600)});
    else if (S.phase !== "menu" && S.phase !== "over") press(S.pointer);
  }
});

/* lobby DOM */
const codeEl = document.getElementById("code");
document.getElementById("bcreate").addEventListener("click", () => {
  const A = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"; let c = "";
  for (let i=0;i<4;i++) c += A[Math.floor(Math.random()*A.length)];
  goOnline(c, true);
});
document.getElementById("bjoin").addEventListener("click", () => {
  const c = codeEl.value.trim().replace(/[^A-Za-z0-9]/g,"");
  if (c.length < 3){ setStat("Enter the code your friend sent you."); return; }
  goOnline(c, false);
});
document.getElementById("bback").addEventListener("click", () => {
  leaveRoom(); lobby.hidden = true; S.phase = "menu";
});

/* ---------- loop ---------- */
V = snapG();
S.view = "pitch";
let last = performance.now();
function frame(now){
  const dt = Math.min(.05, (now-last)/1000); last = now;
  if (S.phase === "flight" && S.pitch && S.phase === "flight" && S.pending && S.ctrl[batSide()] === "remote") {/* handled in update */}
  update(dt); draw();
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

window.__ngs = {S, G, press, startGame, update, draw, applyKind, snapG};
})();
</script>
</body>
