<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Night Game Showdown</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#dfe8da; --ink:#13231a;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#070d12;--ink:#e9f0e6}
}
:root[data-theme="dark"]{--bg:#070d12;--ink:#e9f0e6}
body{
  margin:0;height:100%;background:var(--bg);color:var(--ink);
  font-family:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
}
.wrap{position:relative;width:min(100vw,calc(100svh * 2 / 3),520px)}
canvas{
  display:block;width:100%;height:auto;aspect-ratio:2/3;touch-action:none;cursor:crosshair;
  -webkit-tap-highlight-color:transparent;user-select:none;
  box-shadow:0 0 0 1px rgba(255,255,255,.06);
}
#lobby{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:14px;padding:24px;box-sizing:border-box;background:rgba(5,10,20,.9);color:#e9f0e6;text-align:center;
}
#lobby[hidden]{display:none}
#lobby h2{font-family:"Alfa Slab One",Georgia,serif;font-weight:400;font-size:34px;margin:0;color:#ffd95a}
#lstat{font-size:22px;line-height:1.25;margin:0;max-width:340px;min-height:56px}
#lobby button{
  font:700 26px "Barlow Condensed","Arial Narrow",system-ui,sans-serif;background:#f2c230;color:#0b1428;
  border:0;padding:10px 26px;min-width:220px;cursor:pointer;
}
#lobby button.ghost{background:transparent;color:#b8c5de;border:1px solid rgba(255,255,255,.3);min-width:0}
#lobby button:focus-visible,#lobby input:focus-visible{outline:3px solid #fff;outline-offset:2px}
#lobby .row{display:flex;gap:8px}
#lobby input{
  font:700 28px "Barlow Condensed","Arial Narrow",system-ui,sans-serif;width:130px;text-align:center;
  text-transform:uppercase;background:#0f1a2e;color:#fff;border:1px solid rgba(255,255,255,.35);padding:8px;
}
#lobby .row button{min-width:0;padding:10px 20px}
</style>
</head>
<body>
<div class="wrap">
  <canvas id="c" aria-label="Two-player baseball game. You alternate between batting and pitching."></canvas>
  <div id="lobby" hidden>
    <h2>Play online</h2>
    <p id="lstat">Create a game and send the code to a friend, or enter the code they sent you.</p>
    <button id="bcreate">Create game</button>
    <div class="row"><input id="code" maxlength="6" placeholder="Code" autocomplete="off" autocapitalize="characters" aria-label="Game code"><button id="bjoin">Join</button></div>
    <button id="bback" class="ghost">Back</button>
  </div>
</div>
<script>
(() => {
"use strict";
const cv = document.getElementById("c"), ctx = cv.getContext("2d");
const W = 480, H = 720, CX = 240;
const BZ = {y:480, w:44, h:50};      // strike zone in batter's view
const PZ = {y:330, w:46, h:56};      // strike zone in pitcher's view
const RX = 240, RY = 604;            // pitcher's-view release point
const SX = 240, SY = 256;            // batter's-view release point
const INN = 3, MAXINN = 6;
const DISPLAY = '"Alfa Slab One", "Rockwell", Georgia, serif';
const BODY = '"Barlow Condensed", "Arial Narrow", system-ui, sans-serif';

function fit(){
  const dpr = Math.min(window.devicePixelRatio || 1, 3);
  cv.width = W * dpr; cv.height = H * dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0);
}
fit(); window.addEventListener("resize", fit);

const rand = (a,b) => a + Math.random()*(b-a);
const clamp = (v,a,b) => Math.max(a, Math.min(b, v));
const lerp = (a,b,t) => a + (b-a)*t;
const num = (v,a,b,d) => (typeof v === "number" && isFinite(v)) ? clamp(v,a,b) : d;

/* ---------- audio ---------- */
let AC = null;
function tone(f, d, type="square", vol=0.07, slide=0){
  try{
    AC = AC || new (window.AudioContext || window.webkitAudioContext)();
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = type; o.frequency.value = f;
    if (slide) o.frequency.linearRampToValueAtTime(f+slide, AC.currentTime + d);
    g.gain.value = vol; g.gain.exponentialRampToValueAtTime(0.0001, AC.currentTime + d);
    o.connect(g); g.connect(AC.destination); o.start(); o.stop(AC.currentTime + d);
  }catch(e){}
}
const sndThrow = () => tone(420,.18,"sine",.05,-260);
const sndHit   = () => { tone(210,.09,"square",.1,-80); tone(1100,.05,"triangle",.06); };
const sndMiss  = () => tone(150,.14,"sawtooth",.05,-70);
const sndCall  = () => tone(330,.08,"triangle",.05);
const sndWin   = () => [523,659,784,1047].forEach((f,i)=>setTimeout(()=>tone(f,.16,"triangle",.07),i*90));

/* ---------- data ---------- */
const PITCHES = [
  {name:"Fastball",  desc:"Fast, straight", mph:[91,99], dur:[.80,.90],  scatter:20, off:[0,-8],   contact:0},
  {name:"Slider",    desc:"Bites away",     mph:[83,89], dur:[.98,1.08], scatter:28, off:[38,0],   contact:-.08},
  {name:"Curveball", desc:"Big drop",       mph:[72,80], dur:[1.25,1.38],scatter:36, off:[0,-52],  contact:-.10},
  {name:"Changeup",  desc:"Ruins timing",   mph:[76,83], dur:[1.18,1.30],scatter:26, off:[-16,-16],contact:-.04},
];
const BATTERS = [
  {name:"Slugger",        contact:-.04, power:1.8, chase:0},
  {name:"Contact hitter", contact: .08, power:.5,  chase:0},
  {name:"Rookie",         contact:-.08, power:.8,  chase:.22},
  {name:"Veteran",        contact:0,    power:1,   chase:.05},
];
const WEIGHTS = {
  heart:{foul:.16,ground:.22,fly:.20,single:.22,double:.10,triple:.02,hr:.10},
  edge: {foul:.28,ground:.30,fly:.20,single:.13,double:.06,triple:.01,hr:.03},
  out:  {foul:.30,ground:.35,fly:.22,single:.09,double:.03,triple:0,hr:.01},
};
const FDUR = {hr:1.5, fly:1.35, single:.9, double:1.05, triple:1.15, ground:.85, foul:1.05};
const IN_PLAY = ["ground","fly","single","double","triple","hr","foul"];
const ALL_KINDS = ["ball","called","whiff"].concat(IN_PLAY);
const BTN = PITCHES.map((p,i) => ({x:12 + i*117, y:630, w:109, h:72, i}));
const MENU_BTN = [
  {x:90,y:340,w:300,h:56,label:"Play the computer", act:"cpu"},
  {x:90,y:410,w:300,h:56,label:"Pass and play",     act:"pass"},
  {x:90,y:480,w:300,h:56,label:"Play online",       act:"online"},
];
const GOOD = "#9fe0b5", BAD = "#ff9d8a", NEUT = "#ffd95a", COOL = "#cfe3ff";

/* ---------- state ---------- */
// G is the real game state. V is what the scoreboard shows (updated when a banner appears).
const G = {inning:1, half:"top", outs:0, balls:0, strikes:0, bases:[0,0,0], score:[0,0], over:false, winner:-1};
let V = snapG();
const S = {
  phase:"menu", view:"pitch", mode:"cpu", me:0, ctrl:["human","cpu"], names:["You","CPU"], full:["You","CPU"],
  sel:0, aim:{x:CX,y:PZ.y}, meter:{m:0,dir:1}, pitch:null, flight:null, bat:null, banner:null, after:null,
  timer:0, particles:[], pointer:{x:CX,y:PZ.y}, prevMph:0, prevType:-1, streak:0, cpuBatter:BATTERS[0],
  handoff:null, lastActor:-1, inbox:null, pending:null, seq:0, info:"", msg:"", msgT:0, overAt:0
};
const batSide = () => G.half === "top" ? 0 : 1;
const pitSide = () => 1 - batSide();

function snapG(){
  return {inning:G.inning, half:G.half, outs:G.outs, balls:G.balls, strikes:G.strikes,
    bases:G.bases.slice(), score:G.score.slice(), over:G.over, winner:G.winner};
}
function adoptG(s){
  G.inning = num(s.inning,1,MAXINN+1,1); G.half = s.half === "bot" ? "bot" : "top";
  G.outs = num(s.outs,0,2,0); G.balls = num(s.balls,0,3,0); G.strikes = num(s.strikes,0,2,0);
  G.bases = [0,1,2].map(i => (s.bases && s.bases[i]) ? 1 : 0);
  G.score = [num(s.score && s.score[0],0,99,0), num(s.score && s.score[1],0,99,0)];
  G.over = !!s.over; G.winner = num(s.winner,-1,1,-1);
}

function setNames(){
  if (S.mode === "cpu"){ S.names = ["You","CPU"]; S.full = ["You","CPU"]; S.ctrl = ["human","cpu"]; }
  else if (S.mode === "pass"){ S.names = ["P1","P2"]; S.full = ["Player 1","Player 2"]; S.ctrl = ["human","human"]; }
  else {
    S.names = ["Opp","Opp"]; S.full = ["Opponent","Opponent"];
    S.names[S.me] = "You"; S.full[S.me] = "You";
    S.ctrl = ["remote","remote"]; S.ctrl[S.me] = "human";
  }
}

function startGame(mode, me){
  S.mode = mode; S.me = me || 0; setNames();
  Object.assign(G,{inning:1,half:"top",outs:0,balls:0,strikes:0,bases:[0,0,0],score:[0,0],over:false,winner:-1});
  V = snapG();
  Object.assign(S,{sel:0,aim:{x:CX,y:PZ.y},pitch:null,flight:null,bat:null,banner:null,after:null,particles:[],
    prevMph:0,prevType:-1,streak:0,handoff:null,lastActor:-1,inbox:null,pending:null,seq:0,info:"",msg:""});
  newCpuBatter();
  beginPitch();
}
const newCpuBatter = () => { S.cpuBatter = BATTERS[Math.floor(Math.random()*BATTERS.length)]; };

/* ---------- pitch pipeline ---------- */
function gotoActor(side, phase, view){
  if (view) S.view = view;
  if (S.mode === "pass" && S.lastActor !== side){
    const role = side === pitSide() ? "pitcher" : "batter";
    S.phase = "handoff"; S.handoff = {side, role, phase};
  } else { S.phase = phase; S.lastActor = side; }
}
function beginPitch(){
  S.pitch = null; S.flight = null; S.bat = null; S.banner = null; S.after = null; S.info = ""; S.pending = null;
  const pit = pitSide();
  if (S.ctrl[pit] === "human"){
    S.view = "pitch"; gotoActor(pit, "aim", "pitch");
  } else if (S.ctrl[pit] === "cpu"){
    startFlight(cpuSpec());
  } else {
    S.view = "bat"; S.phase = "wait";
    if (S.inbox && S.inbox.seq === S.seq){ const d = S.inbox; S.inbox = null; startFlight(d); }
  }
}

function startFlight(spec){
  const bat = batSide(), p = {
    type:spec.type, mph:spec.mph, dur:spec.dur, nx:spec.nx, ny:spec.ny, t:0, resolved:false, swung:false,
    ax:spec.ax, ay:spec.ay
  };
  const d = Math.max(Math.abs(p.nx), Math.abs(p.ny));
  p.inZone = d <= 1; p.region = d < .45 ? "heart" : d <= 1 ? "edge" : "out"; p.d = d;
  if (S.ctrl[bat] === "cpu") p.cpu = cpuDecide(p);
  S.streak = (S.prevType === p.type) ? S.streak + 1 : 1; S.prevType = p.type; S.prevMph = p.mph;
  S.pitch = p; S.info = PITCHES[p.type].name + "  " + p.mph + " mph"; S.pending = null;
  sndThrow();
  if (S.ctrl[bat] === "human") gotoActor(bat, "flight", "bat");
  else { S.view = "pitch"; S.phase = "flight"; }
}

/* human pitcher */
const meterError = () => Math.min(1, Math.abs(S.meter.m - .5) * 2);
const scatterR = e => PITCHES[S.sel].scatter * (.12 + 1.35*e);

function release(){
  const T = PITCHES[S.sel], e = meterError();
  const R = scatterR(e), ang = rand(0, Math.PI*2), rr = R*Math.sqrt(Math.random());
  const tx = clamp(S.aim.x + Math.cos(ang)*rr, CX-150, CX+150);
  const ty = clamp(S.aim.y + Math.sin(ang)*rr, PZ.y-135, PZ.y+135);
  const spec = {
    seq:S.seq, type:S.sel, mph:Math.round(rand(T.mph[0], T.mph[1])),
    dur:+(rand(T.dur[0], T.dur[1]) * (1 - .015*(G.inning-1))).toFixed(3),
    nx:+((tx-CX)/PZ.w).toFixed(3), ny:+((ty-PZ.y)/PZ.h).toFixed(3), ax:S.aim.x, ay:S.aim.y
  };
  if (S.mode === "online" && S.ctrl[batSide()] === "remote"){
    const {ax,ay,...wire} = spec; send("pitch", wire);
  }
  startFlight(spec);
  S.pitch.perfect = e < .1;
}

/* CPU pitcher */
function cpuSpec(){
  let r = Math.random(), type = r < .4 ? 0 : r < .6 ? 1 : r < .8 ? 2 : 3;
  const T = PITCHES[type];
  let nx, ny;
  if (Math.random() < .62){
    if (Math.random() < .5){ nx = rand(-.8,.8); ny = rand(-.8,.8); }
    else {
      const a = (Math.random()<.5?-1:1)*rand(.55,.95), b = rand(-.9,.9);
      if (Math.random()<.5){ nx = a; ny = b; } else { nx = b; ny = a; }
    }
  } else {
    const a = (Math.random()<.5?-1:1)*rand(1.1,1.8), b = rand(-1.2,1.2);
    if (Math.random()<.5){ nx = a; ny = b; } else { nx = b; ny = a; }
  }
  return {seq:S.seq, type, mph:Math.round(rand(T.mph[0],T.mph[1])),
    dur:rand(T.dur[0],T.dur[1])*(1-.015*(G.inning-1)), nx, ny};
}

/* CPU batter */
function cpuDecide(p){
  const B = S.cpuBatter, T = PITCHES[p.type], region = p.region, d = p.d;
  let sw = region === "heart" ? .88 : region === "edge" ? .68 : (d < 1.6 ? .32 : .10);
  if (region === "out") sw += B.chase;
  if (G.strikes === 2) sw += region === "heart" ? .1 : .15;
  const swing = Math.random() < clamp(sw,.03,.97);
  let c = .74 + (region === "heart" ? .08 : region === "edge" ? -.08 : -.28);
  c += T.contact;
  if (p.type === 0) c -= (p.mph - 88) * .010;
  if (S.prevMph) c -= clamp((Math.abs(p.mph - S.prevMph) - 5) * .012, 0, .16);
  if (S.streak >= 2 && S.prevType === p.type) c += .12;
  c += .02*(G.inning-1) + B.contact;
  const contact = swing && Math.random() < clamp(c,.08,.9);
  let kind = null, lat = rand(-1,1);
  if (contact){
    const w = Object.assign({}, WEIGHTS[region]);
    w.hr *= B.power; w.double *= 1 + (B.power-1)*.5;
    let tot = 0; for (const k in w) tot += w[k];
    let r = Math.random()*tot; kind = "ground";
    for (const k in w){ if ((r -= w[k]) < 0){ kind = k; break; } }
    if (kind === "foul") lat = (Math.random()<.5?-1:1)*rand(1.15,1.3);
  }
  return {swing, contact, kind, lat};
}

/* ---------- ball positions ---------- */
function ballPitchView(p, z){
  const T = PITCHES[p.type], h = Math.sin(Math.PI*Math.min(z,1));
  const tx = CX + p.nx*PZ.w, ty = PZ.y + p.ny*PZ.h;
  return {x:lerp(RX,tx,z)+T.off[0]*h, y:lerp(RY,ty,z)+T.off[1]*h, r:lerp(20,8,Math.pow(Math.min(z,1),.8))};
}
function ballBatView(p, z){
  const T = PITCHES[p.type], h = Math.sin(Math.PI*Math.min(z,1)), u = Math.max(z,0);
  const tx = CX - p.nx*BZ.w, ty = BZ.y + p.ny*BZ.h;
  return {x:SX+(tx-SX)*u - T.off[0]*.8*h, y:SY+(ty-SY)*Math.pow(u,1.35) + T.off[1]*.8*h, r:3+20*Math.pow(u,1.7)};
}

/* ---------- human batter ---------- */
function swing(px,py){
  const p = S.pitch;
  if (S.phase !== "flight" || S.view !== "bat" || !p || p.swung || p.resolved) return;
  p.swung = true; S.bat = {t:0, x:px, y:py};
  const z = p.t / p.dur, dz = z - 1, b = ballBatView(p, z), d = Math.hypot(px-b.x, py-b.y);
  if (Math.abs(dz) < .15 && d < 62){
    p.resolved = true; p.zc = Math.min(z,1.05);
    const qt = 1 - Math.abs(dz)/.15, qd = 1 - d/62, q = .6*qt + .4*qd;
    const timing = Math.abs(dz) < .03 ? "Perfect timing" : (dz < 0 ? "A little early" : "A little late");
    let lat = clamp((clamp(CX + dz*1400 + (px - b.x)*2.2, 40, 440) - CX)/220, -1, 1), kind;
    if (q < .28){ kind = "foul"; lat = (dz < 0 ? -1 : 1)*rand(1.15,1.25); }
    else {
      let r = Math.random();
      const hrP = q > .6 ? (q-.6)*1.8 : 0, trP = q > .8 ? .04 : 0, dbP = q > .5 ? (q-.5)*.9 : 0, sP = .12 + .35*q;
      if ((r -= hrP) < 0) kind = "hr";
      else if ((r -= trP) < 0) kind = "triple";
      else if ((r -= dbP) < 0) kind = "double";
      else if ((r -= sP) < 0) kind = "single";
      else kind = Math.random() < .55 ? "ground" : "fly";
    }
    sndHit();
    resolveLocal(kind, lat, true, timing);
  } else sndMiss();
}

/* ---------- outcomes ---------- */
function runsText(n){ return n ? "+" + n + (n===1?" run":" runs") : ""; }
function endPA(){ G.balls = 0; G.strikes = 0; newCpuBatter(); }
function addOut(){
  G.outs++; endPA();
  if (G.outs < 3) return false;
  G.outs = 0; G.bases = [0,0,0];
  if (G.half === "top"){
    if (G.inning >= INN && G.score[1] > G.score[0]){ G.over = true; G.winner = 1; }
    else G.half = "bot";
  } else {
    if (G.inning >= INN && G.score[0] !== G.score[1]){ G.over = true; G.winner = G.score[0] > G.score[1] ? 0 : 1; }
    else if (G.inning >= MAXINN){ G.over = true; G.winner = -1; }
    else { G.inning++; G.half = "top"; }
  }
  return true;
}
function advance(n){
  let scored = 0; const nb = [0,0,0];
  for (let i=2;i>=0;i--) if (G.bases[i]){
    const ni = i + n;
    if (ni >= 3) scored++; else nb[ni] = 1;
  }
  nb[n-1] = 1; G.bases = nb; return scored;
}

function applyKind(kind, extra){
  const bs = batSide(), half0 = G.half;
  let text = "", sub = "", gb = 0, dur = 1.1, sc = 0, sideOut = false;
  switch (kind){
    case "ball":
      G.balls++;
      if (G.balls >= 4){
        const b = G.bases;
        if (b[0]){ if (b[1]){ if (b[2]) sc++; b[2] = 1; } b[1] = 1; }
        b[0] = 1; endPA(); text = "Walk"; sub = sc ? runsText(sc) + " forced in" : "Take your base"; gb = 1;
      } else { text = "Ball " + G.balls; dur = .75; }
      break;
    case "called": case "whiff":
      G.strikes++; gb = -1;
      if (G.strikes >= 3){ text = kind === "whiff" ? "Strikeout!" : "Struck out looking"; dur = 1.2; sideOut = addOut(); }
      else { text = kind === "whiff" ? "Swing and a miss" : "Strike " + G.strikes; sub = kind === "whiff" ? "Strike " + G.strikes : "Called"; dur = .8; }
      break;
    case "foul":
      if (G.strikes < 2) G.strikes++;
      text = "Foul ball"; sub = extra || (G.strikes >= 2 ? "Two strikes" : "Strike " + G.strikes); dur = .85; extra = "";
      break;
    case "ground":
      gb = -1; text = "Grounded out";
      if (G.bases[0] && G.outs < 2 && Math.random() < .35){ G.bases[0] = 0; G.outs++; text = "Double play"; }
      sideOut = addOut(); break;
    case "fly":
      gb = -1; text = "Flied out";
      if (G.bases[2] && G.outs < 2 && Math.random() < .5){ G.bases[2] = 0; sc = 1; text = "Sacrifice fly"; gb = 0; }
      sideOut = addOut(); break;
    case "single": sc = advance(1); endPA(); text = "Single"; gb = 1; dur = 1.2; break;
    case "double": sc = advance(2); endPA(); text = "Double"; gb = 1; dur = 1.2; break;
    case "triple": sc = advance(3); endPA(); text = "Triple!"; gb = 1; dur = 1.3; break;
    case "hr":     sc = 1 + G.bases[0] + G.bases[1] + G.bases[2]; G.bases = [0,0,0]; endPA(); text = "Home run!"; gb = 1; dur = 1.9; break;
  }
  G.score[bs] += sc;
  if (!G.over && !sideOut && half0 === "bot" && G.inning >= INN && G.score[1] > G.score[0]){
    G.over = true; G.winner = 1; sub = "Walk-off!";
  }
  if (sc && !sub.startsWith("Walk-off")) sub = runsText(sc) + (extra ? "  " + extra : "");
  else if (sideOut && !sub){
    sub = G.over ? "That's the game" : "Side retired. " + (G.half === "bot" ? "Bottom " : "Top ") + G.inning;
  } else if (!sub && extra) sub = extra;
  return {text, sub, gb, dur};
}

function resolveLocal(kind, lat, swung, extra){
  const iBat = S.mode === "online" && S.ctrl[batSide()] === "human";
  const banner = applyKind(kind, extra);
  const o = {seq:S.seq, kind, lat:+lat.toFixed(2), swing:!!swung, banner, snap:snapG()};
  S.seq++;
  if (iBat) send("result", o);
  present(o);
}

function present(o){
  S.after = o.banner;
  if (IN_PLAY.includes(o.kind)){
    const p = S.pitch;
    S.flight = {kind:o.kind, lat:o.lat, t:0, dur:FDUR[o.kind], zc:(p && p.zc) || 1};
    S.phase = "hit";
  } else {
    if (o.kind === "whiff") sndMiss(); else sndCall();
    showBanner(o.banner);
  }
}

function showBanner(b){
  const role = S.view === "bat" ? 1 : -1, eff = (b.gb||0) * role;
  S.banner = {text:b.text, sub:b.sub, color: eff > 0 ? GOOD : eff < 0 ? BAD : (b.gb ? NEUT : COOL), t:0};
  S.timer = b.dur; S.phase = "result"; V = snapG();
  if (b.text === "Home run!") boom(45);
  if (b.text === "Strikeout!" || b.text === "Struck out looking") boom(16);
}
function afterBanner(){
  S.banner = null;
  if (G.over){ S.phase = "over"; S.overAt = performance.now(); if (G.winner !== -1) sndWin(); return; }
  beginPitch();
}

function boom(n){
  const cols = ["#ffd95a","#ffffff","#7fd1ff","#9fe0b5"];
  for (let i=0;i<n;i++) S.particles.push({
    x:CX+rand(-30,30), y:S.view === "bat" ? 260 : 340, vx:rand(-230,230), vy:rand(-420,-80),
