/* ---------- online ---------- */
let R = null, started = false;
const lobby = document.getElementById("lobby"), lstat = document.getElementById("lstat");
const setStat = s => { lstat.textContent = s; };

function send(topic, data){
  if (!R) return;
  R.emit(topic, data).catch(e => {
    if (e && e.code === "not_permitted") flash("Your link is view-only. Ask for edit access to play online.");
  });
}
function flash(m){ S.msg = m; S.msgT = 5; }

async function leaveRoom(){
  started = false;
  const r = R; R = null;
  try { if (r) await r.leave(); } catch(e){}
}

async function goOnline(code, creating){
  setStat("Connecting...");
  let room = null;
  try { room = window.claude && window.claude.use ? await window.claude.use("room") : null; } catch(e){}
  if (!room){ setStat("Online play isn't available in this view. Open the shared link while signed in."); return; }
  try { R = await room.join("ngs-" + code.toLowerCase()); }
  catch(e){ R = null; setStat("Couldn't join that game (" + ((e && e.code) || "error") + ")."); return; }
  R.on("pitch", m => { if (!m.isMe) onPitch(m.data); });
  R.on("result", m => { if (!m.isMe) onResult(m.data); });
  R.onPeers(onPeers);
  R.presence({ready:true}).catch(()=>{});
  setStat(creating ? "Game code: " + code + "\nSend it to a friend. Waiting for them to join..." : "Joined " + code + ". Waiting for the other player...");
}

function onPeers(change){
  const people = change.peers.filter(p => p.kind === "viewer").sort((a,b) => a.peer < b.peer ? -1 : 1);
  if (!started){
    if (people.length < 2) return;
    const two = people.slice(0,2), me = two.findIndex(p => p.isMe && p.sameTab);
    if (me < 0){ setStat("That game already has two players."); return; }
    started = true; lobby.hidden = true;
    startGame("online", me);
  } else if (people.length < 2 && S.phase !== "over" && S.phase !== "menu"){
    started = false; flash("Your opponent left the game.");
    S.phase = "menu"; leaveRoom();
  }
}

function onPitch(d){
  if (!d || S.mode !== "online" || S.ctrl[pitSide()] !== "remote" || d.seq !== S.seq) return;
  const spec = {
    seq:d.seq, type:Math.floor(num(d.type,0,PITCHES.length-1,0)), mph:Math.round(num(d.mph,50,110,90)),
    dur:num(d.dur,.5,2,1), nx:num(d.nx,-3,3,0), ny:num(d.ny,-3,3,0)
  };
  if (S.phase === "wait") startFlight(spec); else S.inbox = spec;
}
function onResult(d){
  if (!d || S.mode !== "online" || S.ctrl[batSide()] !== "remote" || d.seq !== S.seq) return;
  if (!ALL_KINDS.includes(d.kind) || !d.banner || !d.snap) return;
  const b = d.banner;
  S.pending = {
    kind:d.kind, lat:num(d.lat,-2,2,0), swing:!!d.swing, snap:d.snap,
    banner:{text:String(b.text||"").slice(0,40), sub:String(b.sub||"").slice(0,60), gb:num(b.gb,-1,1,0), dur:num(b.dur,.6,2.5,1.1)}
  };
}
function processResult(o){
  S.pending = null;
  adoptG(o.snap); S.seq++;
  if (o.swing && !S.bat) S.bat = {t:.08};
  present(o);
}

/* ---------- update ---------- */
function update(dt){
  if (S.bat){ S.bat.t += dt; if (S.bat.t > .45) S.bat = null; }
  for (const q of S.particles){ q.life -= dt; q.vy += 520*dt; q.x += q.vx*dt; q.y += q.vy*dt; }
  S.particles = S.particles.filter(q => q.life > 0);
  if (S.banner) S.banner.t += dt;
  if (S.msgT > 0) S.msgT -= dt;

  switch (S.phase){
    case "meter": {
      const m = S.meter; m.m += m.dir * dt * 1.55;
      if (m.m >= 1){ m.m = 1; m.dir = -1; } else if (m.m <= 0){ m.m = 0; m.dir = 1; }
      break;
    }
    case "flight": {
      const p = S.pitch; p.t += dt;
      const z = p.t / p.dur, cb = S.ctrl[batSide()];
      if (cb === "cpu"){
        if (p.cpu.swing && !S.bat && z >= 1 - .17/p.dur) S.bat = {t:0};
        if (z >= 1 && !p.resolved){
          p.resolved = true; p.zc = 1;
          if (p.cpu.contact){ sndHit(); resolveLocal(p.cpu.kind, p.cpu.lat, true); }
          else if (p.cpu.swing) resolveLocal("whiff", 0, true);
          else resolveLocal(p.inZone ? "called" : "ball", 0, false);
        }
      } else if (cb === "human"){
        if (z >= 1.05 && !p.resolved){
          p.resolved = true; p.zc = 1;
          resolveLocal(p.swung ? "whiff" : (p.inZone ? "called" : "ball"), 0, p.swung);
        }
      } else if (S.pending && z >= 1 && !p.resolved){
        p.resolved = true; processResult(S.pending);
      }
      break;
    }
    case "hit":
      S.flight.t += dt; if (S.flight.t >= S.flight.dur) showBanner(S.after); break;
    case "result":
      S.timer -= dt; if (S.timer <= 0) afterBanner(); break;
  }
}

